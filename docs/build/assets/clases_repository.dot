digraph G { rankdir=BT; nodesep=0.3; ranksep=0.55; bgcolor="white"; edge [color="#4A2C1F" fontname="Inter" fontsize=8];
"BaseRepository" [shape=record fillcolor="#FFF4CC" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{BaseRepository|tabla : str\l_cur : cursor (opcional)\l|_run(sql, params, one) : rows\lfind_all(order_by) : list\lfind_by_id(id) : dict\l}"];
"UsuarioRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{UsuarioRepository||find_by_email(email)\lcrear(nombre, email, hash, rol)\lregistrar_fallo(id, max, min)\lregistrar_acceso(id)\l}"];
"SesionRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{SesionRepository||crear(usuario_id, token_hash, ...)\lbuscar_valida(token_hash)\lrevocar(token_hash)\l}"];
"InsumoRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{InsumoRepository||listar()\lbloquear_para_actualizar(id)\lcontar_quiebres()\l}"];
"MovimientoRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{MovimientoRepository||registrar(insumo, tipo, cantidad, ...)\lultimos(insumo_id)\l}"];
"OrdenRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{OrdenRepository||listar()\lcrear(lote, producto, ...)\lcambiar_estado(id, estado)\l}"];
"ProductoRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{ProductoRepository||listar()\lbom(producto_id)\l}"];
"AlertaRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{AlertaRepository||listar()\l}"];
"PronosticoRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{PronosticoRepository||serie() : dict\lmape_promedio() : float\l}"];
"AuditoriaRepository" [shape=record fillcolor="#FFFDF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{AuditoriaRepository||registrar(accion, usuario, ...)\lultimos(limite)\l}"];
"auth_service" [shape=record fillcolor="#E4F3E9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{auth_service||login(email, password, ip)\lrefresh(token)\llogout(token)\l}"];
"Rutas (Flask)" [shape=record fillcolor="#E4EEF9" style=filled color="#4A2C1F" fontname="Inter" fontsize=9 label="{Rutas (Flask)||/api/inventario\l/api/produccion\l/api/productos\l/api/forecast\l/api/auth/*\l}"];
db [shape=cylinder label="PostgreSQL" fillcolor="#E4EEF9" style=filled fontname="Inter" fontsize=9];
UsuarioRepository -> BaseRepository [arrowhead=empty]; SesionRepository -> BaseRepository [arrowhead=empty]; InsumoRepository -> BaseRepository [arrowhead=empty]; MovimientoRepository -> BaseRepository [arrowhead=empty]; OrdenRepository -> BaseRepository [arrowhead=empty]; PronosticoRepository -> BaseRepository [arrowhead=empty]; AuditoriaRepository -> BaseRepository [arrowhead=empty]; ProductoRepository -> BaseRepository [arrowhead=empty]; AlertaRepository -> BaseRepository [arrowhead=empty];
auth_service -> UsuarioRepository [style=dashed label="usa"]; auth_service -> SesionRepository [style=dashed]; auth_service -> AuditoriaRepository [style=dashed];
"Rutas (Flask)" -> auth_service [style=dashed label="usa"]; "Rutas (Flask)" -> InsumoRepository [style=dashed]; "Rutas (Flask)" -> OrdenRepository [style=dashed]; "Rutas (Flask)" -> MovimientoRepository [style=dashed]; "Rutas (Flask)" -> PronosticoRepository [style=dashed]; "Rutas (Flask)" -> ProductoRepository [style=dashed]; "Rutas (Flask)" -> AlertaRepository [style=dashed];
BaseRepository -> db [label="SQL parametrizado\n(transaction())" arrowhead=normal];}