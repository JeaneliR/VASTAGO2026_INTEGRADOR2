digraph G { rankdir=LR; nodesep=0.35; ranksep=0.9; bgcolor="white"; edge [color="#4A2C1F" arrowhead=crow arrowtail=tee dir=both fontname="Inter" fontsize=8];
roles [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(40) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="9">descripcion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(200)</FONT></TD></TR></TABLE>>];
usuarios [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT POINT-SIZE="9">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(120) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"><FONT POINT-SIZE="9">password_hash</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(100) bcrypt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_id"><FONT POINT-SIZE="9"><I>FK </I>rol_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono_cifrado"><FONT POINT-SIZE="9">telefono_cifrado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BYTEA AES-GCM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="intentos_fallidos"><FONT POINT-SIZE="9">intentos_fallidos</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bloqueado_hasta"><FONT POINT-SIZE="9">bloqueado_hasta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ultimo_acceso"><FONT POINT-SIZE="9">ultimo_acceso</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="9">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
sesiones [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>sesiones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BIGSERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id"><FONT POINT-SIZE="9"><I>FK </I>usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token_hash"><FONT POINT-SIZE="9">token_hash</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">CHAR(64) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expira_en"><FONT POINT-SIZE="9">expira_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="revocada"><FONT POINT-SIZE="9">revocada</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip"><FONT POINT-SIZE="9">ip</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(45)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_agent"><FONT POINT-SIZE="9">user_agent</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creada_en"><FONT POINT-SIZE="9">creada_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
auditoria [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>auditoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BIGSERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id"><FONT POINT-SIZE="9"><I>FK </I>usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT POINT-SIZE="9">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="accion"><FONT POINT-SIZE="9">accion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entidad"><FONT POINT-SIZE="9">entidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle"><FONT POINT-SIZE="9">detalle</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip"><FONT POINT-SIZE="9">ip</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(45)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="exito"><FONT POINT-SIZE="9">exito</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="9">fecha</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
insumos [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>insumos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(100) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unidad"><FONT POINT-SIZE="9">unidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_actual"><FONT POINT-SIZE="9">stock_actual</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(12,3) ≥0</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_minimo"><FONT POINT-SIZE="9">stock_minimo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="costo_unitario"><FONT POINT-SIZE="9">costo_unitario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en"><FONT POINT-SIZE="9">actualizado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
movimientos_inventario [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>movimientos_inventario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">BIGSERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="insumo_id"><FONT POINT-SIZE="9"><I>FK </I>insumo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="9">tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INGRESO|SALIDA|AJUSTE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad"><FONT POINT-SIZE="9">cantidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(12,3) &gt;0</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo"><FONT POINT-SIZE="9">motivo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="orden_id"><FONT POINT-SIZE="9"><I>FK </I>orden_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id"><FONT POINT-SIZE="9"><I>FK </I>usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="9">fecha</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
productos [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>productos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(100) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="precio"><FONT POINT-SIZE="9">precio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(10,2)</FONT></TD></TR></TABLE>>];
bom [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>bom</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="producto_id"><FONT POINT-SIZE="9"><B>PK </B>producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="insumo_id"><FONT POINT-SIZE="9"><B>PK </B>insumo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad_por_unidad"><FONT POINT-SIZE="9">cantidad_por_unidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(10,4)</FONT></TD></TR></TABLE>>];
ordenes_produccion [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>ordenes_produccion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lote"><FONT POINT-SIZE="9">lote</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(20) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="producto_id"><FONT POINT-SIZE="9"><I>FK </I>producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad"><FONT POINT-SIZE="9">cantidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT &gt;0</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio"><FONT POINT-SIZE="9">fecha_inicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="9">estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">Planificada|En proceso|Completada</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_por"><FONT POINT-SIZE="9"><I>FK </I>creado_por</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="9">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
demanda_historica [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>demanda_historica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="producto_id"><FONT POINT-SIZE="9"><B>PK </B>producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mes"><FONT POINT-SIZE="9"><B>PK </B>mes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kg"><FONT POINT-SIZE="9">kg</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(10,2)</FONT></TD></TR></TABLE>>];
pronosticos [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>pronosticos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="producto_id"><FONT POINT-SIZE="9"><B>PK </B>producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mes"><FONT POINT-SIZE="9"><B>PK </B>mes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kg"><FONT POINT-SIZE="9">kg</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mape"><FONT POINT-SIZE="9">mape</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="modelo"><FONT POINT-SIZE="9">modelo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(60)</FONT></TD></TR></TABLE>>];
alertas [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4A2C1F"><TR><TD COLSPAN="2" BGCOLOR="#4A2C1F"><FONT COLOR="white" POINT-SIZE="10"><B>alertas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9"><B>PK </B>id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nivel"><FONT POINT-SIZE="9">nivel</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">crit|warn</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo"><FONT POINT-SIZE="9">titulo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle"><FONT POINT-SIZE="9">detalle</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">VARCHAR(400)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creada_en"><FONT POINT-SIZE="9">creada_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#6B3F2A">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
roles -> usuarios [taillabel="1" headlabel="N"]; usuarios -> sesiones; usuarios -> auditoria; usuarios -> ordenes_produccion; usuarios -> movimientos_inventario;
insumos -> movimientos_inventario; insumos -> bom; productos -> bom; productos -> ordenes_produccion; productos -> demanda_historica; productos -> pronosticos;
ordenes_produccion -> movimientos_inventario; }