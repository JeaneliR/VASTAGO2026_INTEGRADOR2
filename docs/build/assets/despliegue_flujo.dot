digraph G { rankdir=TB; nodesep=0.35; ranksep=0.4; bgcolor="white"; node [shape=box style="rounded,filled" fillcolor="#FFFDF9" color="#4A2C1F" fontname="Inter" fontsize=11 margin="0.14,0.08"]; edge [color="#4A2C1F" fontname="Inter" fontsize=9 arrowsize=0.8];
