subgraph cluster_r { label="Render (cuenta del equipo)"; style="rounded,filled"; fillcolor="#F6EFE3"; color="#4A2C1F"; fontname="Inter" fontsize=11
  bp [label="1. Blueprint\nlee render.yaml"];
  db [label="2. PostgreSQL 16 gestionado\nvastago-db (plan free)" shape=cylinder fillcolor="#E4EEF9"];
